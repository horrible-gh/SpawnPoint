{
  "ok": true,
  "spec_version": "2026-08-11.1",
  "service_version": "1.0.0",
  "base_path": "/",
  "media_type": "application/json; charset=utf-8",
  "request_body_max_bytes": 65536,
  "decision_order": [
    "body_size",
    "path",
    "method",
    "authentication",
    "json",
    "fields"
  ],
  "authentication": {
    "mode": "conditional_bearer",
    "default_enabled": false,
    "enabled_when": "SPAWNPOINT_API_TOKENS is non-empty",
    "header": "Authorization: Bearer <token>",
    "auth_free_paths": [
      "/",
      "/index.html",
      "/healthz"
    ],
    "help_requires_auth_when_enabled": true
  },
  "security_boundary": {
    "default_bind": "127.0.0.1:8091",
    "arbitrary_shell_command_execution": true,
    "remote_binding_exposes_api": true,
    "remote_binding_requires_authentication": true,
    "remote_binding_requires_network_access_control": true
  },
  "success_evaluation": {
    "http_status_only_sufficient": false,
    "rules": [
      {
        "id": "require_2xx_and_ok",
        "description": "HTTP must be 2xx and ok must be true."
      },
      {
        "id": "require_persisted_for_durability",
        "description": "When persisted is present, durability requires persisted to be true."
      },
      {
        "id": "failed_status_means_start_failure_even_on_200",
        "description": "A failed process status means start failure even with HTTP 200."
      },
      {
        "id": "require_running_when_running_is_the_goal",
        "description": "When running is the goal, process.status must be running."
      },
      {
        "id": "delete_persisted_false_may_revive_after_restart",
        "description": "A delete with persisted false may be restored after restart."
      }
    ]
  },
  "process_statuses": [
    {
      "name": "stopped",
      "null_fields": [],
      "conditional_fields": [
        "pid",
        "exit_code",
        "started_at",
        "ended_at"
      ]
    },
    {
      "name": "running",
      "null_fields": [
        "exit_code",
        "ended_at"
      ],
      "conditional_fields": []
    },
    {
      "name": "exited",
      "null_fields": [],
      "conditional_fields": []
    },
    {
      "name": "killed",
      "null_fields": [],
      "conditional_fields": []
    },
    {
      "name": "failed",
      "null_fields": [
        "pid",
        "exit_code",
        "started_at"
      ],
      "conditional_fields": [
        "error"
      ]
    }
  ],
  "error_catalog": [
    {
      "id": "invalid_json",
      "code": "invalid_request",
      "http_status": 400,
      "message": "Request body is not valid JSON.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "invalid_object",
      "code": "invalid_request",
      "http_status": 400,
      "message": "Request body must be an object.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "cmd_empty",
      "code": "invalid_request",
      "http_status": 400,
      "message": "cmd cannot be empty.",
      "field": "cmd",
      "field_condition": "cmd missing, null, non-string, empty, or whitespace-only"
    },
    {
      "id": "cmd_too_long",
      "code": "invalid_request",
      "http_status": 400,
      "message": "cmd is too long.",
      "field": "cmd",
      "field_condition": "cmd exceeds 4096 Unicode code points"
    },
    {
      "id": "label_invalid",
      "code": "invalid_request",
      "http_status": 400,
      "message": "label must be a string.",
      "field": "label",
      "field_condition": "specified label is non-string, empty, or whitespace-only"
    },
    {
      "id": "label_too_long",
      "code": "invalid_request",
      "http_status": 400,
      "message": "label is too long.",
      "field": "label",
      "field_condition": "label exceeds 128 Unicode code points"
    },
    {
      "id": "cwd_invalid",
      "code": "invalid_request",
      "http_status": 400,
      "message": "cwd must be a string.",
      "field": "cwd",
      "field_condition": "specified cwd is not a string"
    },
    {
      "id": "env_invalid",
      "code": "invalid_request",
      "http_status": 400,
      "message": "env must be an object with string keys and values.",
      "field": "env",
      "field_condition": "env is not an object of string values"
    },
    {
      "id": "auto_start_invalid",
      "code": "invalid_request",
      "http_status": 400,
      "message": "auto_start must be a boolean.",
      "field": "auto_start",
      "field_condition": "specified auto_start is null or not a boolean"
    },
    {
      "id": "unauthorized",
      "code": "unauthorized",
      "http_status": 401,
      "message": "Valid authentication token required.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "process_not_found",
      "code": "not_found",
      "http_status": 404,
      "message": "Process not found.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "unknown_endpoint",
      "code": "not_found",
      "http_status": 404,
      "message": "Unknown endpoint.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "method_not_allowed",
      "code": "method_not_allowed",
      "http_status": 405,
      "message": "Method not allowed.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "payload_too_large",
      "code": "payload_too_large",
      "http_status": 413,
      "message": "Request body is too large.",
      "field": null,
      "field_condition": "no field key"
    },
    {
      "id": "storage_error",
      "code": "storage_error",
      "http_status": 500,
      "message": "Failed to save instance.",
      "field": null,
      "field_condition": "no field key; /spawn only"
    }
  ],
  "schemas": {
    "registration": {
      "keys": [
        "cmd",
        "label",
        "cwd",
        "env",
        "auto_start",
        "run_as"
      ],
      "fields": [
        {
          "name": "cmd",
          "type": "string",
          "required": true,
          "nullable": false,
          "default": null,
          "validation_order": 1,
          "max_runes": 4096
        },
        {
          "name": "label",
          "type": "string",
          "required": false,
          "nullable": true,
          "default": "first_word_of_cmd",
          "validation_order": 2,
          "max_runes": 128
        },
        {
          "name": "cwd",
          "type": "string",
          "required": false,
          "nullable": true,
          "default": null,
          "validation_order": 3,
          "max_runes": null
        },
        {
          "name": "env",
          "type": "object<string,string>",
          "required": false,
          "nullable": true,
          "default": "empty_object",
          "validation_order": 4,
          "max_runes": null
        },
        {
          "name": "auto_start",
          "type": "boolean",
          "required": false,
          "nullable": false,
          "default": false,
          "validation_order": 5,
          "max_runes": null,
          "update_omission": "preserve_existing_value",
          "description": "Start once when SpawnPoint starts. Saving this preference does not start or restart the process immediately."
        },
        {
          "name": "run_as",
          "type": "object",
          "required": false,
          "nullable": false,
          "default": null,
          "validation_order": 6,
          "max_runes": null,
          "description": "Optional execution identity: {mode: service} removes credentials; {mode: user, username, domain?, password?} uses an authenticated OS account. Omission preserves the current identity on update. An omitted password only preserves a credential for the same account."
        }
      ],
      "unknown_top_level_fields": "ignored"
    },
    "process": {
      "keys": [
        "id",
        "label",
        "cmd",
        "cwd",
        "env",
        "pid",
        "status",
        "exit_code",
        "started_at",
        "ended_at",
        "error",
        "auto_start",
        "run_as"
      ],
      "conditional_keys": {
        "error": "status == failed",
        "auto_start": "included only when true; absence means false",
        "run_as": "Included for a specified account; contains mode, username, optional domain, has_password; never password or sealed credential."
      }
    },
    "list_response": {
      "keys": [
        "ok",
        "processes"
      ]
    },
    "write_response": {
      "keys": [
        "ok",
        "persisted",
        "process"
      ]
    },
    "process_response": {
      "keys": [
        "ok",
        "process"
      ]
    },
    "delete_response": {
      "keys": [
        "ok",
        "persisted",
        "deleted_id"
      ]
    },
    "log_response": {
      "keys": [
        "ok",
        "text",
        "start_offset",
        "next_offset",
        "size",
        "truncated",
        "reset",
        "encoding",
        "generation"
      ]
    },
    "error_response": {
      "keys": [
        "ok",
        "error"
      ]
    },
    "help_response": {
      "keys": [
        "ok",
        "spec_version",
        "service_version",
        "base_path",
        "media_type",
        "request_body_max_bytes",
        "decision_order",
        "authentication",
        "security_boundary",
        "success_evaluation",
        "process_statuses",
        "error_catalog",
        "schemas",
        "endpoints"
      ]
    },
    "runtime_response": {
      "keys": [
        "ok",
        "os",
        "service_account",
        "run_as_supported",
        "run_as_reason"
      ]
    }
  },
